{
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "noEmit": true,
    "types": ["@cloudflare/workers-types", "@cloudflare/vitest-pool-workers"],
    "lib": ["ES2022"],
    "skipLibCheck": true
  },
  "include": ["src/**/*", "test/helpers/**/*", "test/workers/**/*", "config/*.json"]
}
